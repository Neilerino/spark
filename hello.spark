fn loop_with_break(n: Int): Int {
    count: Int! = 0
    loop {
        if count >= n {
            break count
        }
        print(count)
        count += 1
        if count == 5 {
            return count
        }
    }
    return count
}

fn main(): Void {
    items: List[Int] = [1, 2, 3]
    loop_with_break(10)
}
