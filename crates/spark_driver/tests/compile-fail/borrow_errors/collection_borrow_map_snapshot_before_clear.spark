struct Holder { target: Ref[Map[String, Ref[Int]]]! }
fn work(holder: Ref[Holder]!, value: Ref[Int]): Map[String, Ref[Int]] {
    next: Map[String, Ref[Int]] = {"one": value}
    holder.target = next
    snapshot: Map[String, Ref[Int]] = holder.target
    empty: Map[String, Ref[Int]] = {}
    holder.target = empty
    return snapshot
}
fn produce(target: Ref[Map[String, Ref[Int]]]!, value: Int): Map[String, Ref[Int]] {
    holder: Holder! = Holder { target: target }
    view: Ref[Holder]! = holder
    borrowed: Ref[Int] = value
    return work(view, borrowed)
}
fn main(): Int {
    entries: Map[String, Ref[Int]]! = {}
    target: Ref[Map[String, Ref[Int]]]! = entries
    result: Map[String, Ref[Int]] = produce(target, 7)
    print(result.len())
    return 0
}
