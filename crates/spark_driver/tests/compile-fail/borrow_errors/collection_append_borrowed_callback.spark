// TAG [SPARK-114]

fn produce(): List[(): Int] {
    local: Int = 7
    value: Ref[Int] = local
    read: (): Int = fn(): Int { return value }
    callbacks: List[(): Int]! = []
    callbacks.append(read)
    return callbacks
}
fn main(): Int {
    callbacks: List[(): Int] = produce()
    selected: (): Int = callbacks[0] ?? fn(): Int { return 0 }
    print(selected())
    return 0
}
