fn display(entries: Map[String, Ref[List[Int]]]): Void {
    entries["one"] to { found: Ref[List[Int]] -> print(found.len()), Null -> print(99) }
}
fn main(): Int {
    values: List[Int]! = [1, 2]
    borrowed: Ref[List[Int]] = values
    entries: Map[String, Ref[List[Int]]] = {"one": borrowed}
    values[0] = 9
    display(entries)
    return 0
}
