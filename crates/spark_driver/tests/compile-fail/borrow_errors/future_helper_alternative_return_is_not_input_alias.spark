// TAG [SPARK-114]

async fn lengthAfter(signal: Channel[Int], values: List[Ref[String]]): Int {
    token: Int = signal.recv()
    fallback: String = "outside"
    fallbackRef: Ref[String] = fallback
    value: Ref[String] = values[0] ?? fallbackRef
    print(value.len())
    return value.len()
}
async fn zero(): Int { return 0 }
fn chooseTask(first: Future[Int], second: Future[Int], useFirst: Bool): Future[Int] {
    if useFirst { return first }
    return second
}
fn main(): Int {
    signal: Channel[Int] = Channel[Int]()
    pending: Future[Int]! = spawn { zero() }
    if true {
        text: String = " seven ".trim()
        borrowed: Ref[String] = text
        values: List[Ref[String]] = [borrowed]
        pending = spawn { lengthAfter(signal, values) }
        replacement: Future[Int] = spawn { zero() }
        selected: Future[Int] = chooseTask(pending, replacement, false)
        print(await selected)
    }
    signal.send(1)
    return 0
}
