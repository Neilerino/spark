// TAG [SPARK-114]

fn apply(callback: (): Ref[Int]): Ref[Int] { return callback() }
fn nest(callback: (): Ref[Int]): (): Ref[Int] { return fn(): Ref[Int] { return callback() } }
fn produce(): Ref[Int] {
    local: Int = 7
    borrowed: Ref[Int] = local
    queue: Channel[Ref[Int]] = Channel[Ref[Int]]()
    queue.send(borrowed)
    read: (): Ref[Int] = fn(): Ref[Int] { return queue.recv() }
    return apply(nest(nest(read)))
}
fn main(): Int {
    found: Ref[Int] = produce()
    print(found)
    return 0
}
