fn produce(): List[Ref[Int]] {
    local: Int = 7
    value: Ref[Int] = local
    values: List[Ref[Int]]! = []
    values.append(value)
    return values
}
fn main(): Int {
    outside: Int = 9
    borrowed: Ref[Int] = outside
    values: List[Ref[Int]] = produce()
    result: Ref[Int] = values[0] ?? borrowed
    print(result)
    return 0
}
