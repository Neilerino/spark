fn main(): Int {
    fallback: String = "outside"
    fallbackRef: Ref[String] = fallback
    values: List[Ref[String]]! = [fallbackRef]
    if true {
        text: String = " seven ".trim()
        borrowed: Ref[String] = text
        values[0] = borrowed
    }
    result: Ref[String] = values[0] ?? fallbackRef
    print(result)
    return 0
}
