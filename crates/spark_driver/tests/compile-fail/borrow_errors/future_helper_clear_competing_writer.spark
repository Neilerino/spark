// TAG [SPARK-114]
struct Cell { entries: Map[String, Ref[String]]! }
struct Shared { cell: Ref[Cell]! }
async fn install(shared: Shared, input: Channel[Ref[String]], started: Channel[Int], ready: Channel[Int]): Int {
    started.send(1)
    value: Ref[String] = input.recv()
    entries: Map[String, Ref[String]] = {"one": value}
    cell: Ref[Cell]! = shared.cell
    cell.entries = entries
    ready.send(1)
    return 0
}
async fn compete(shared: Shared, input: Channel[Ref[String]], release: Channel[Int]): Int {
    value: Ref[String] = input.recv()
    proceed: Int = release.recv()
    cell: Ref[Cell]! = shared.cell
    entries: Map[String, Ref[String]] = {"one": value}
    cell.entries = entries
    return 0
}
fn joinAndClear(pending: Future[Int], shared: Shared): Int {
    finished: Int = await pending
    cell: Ref[Cell]! = shared.cell
    cleared: Map[String, Ref[String]] = {}
    cell.entries = cleared
    return finished
}
fn main(): Int {
    empty: Map[String, Ref[String]] = {}
    cell: Cell! = Cell { entries: empty }
    cellRef: Ref[Cell]! = cell
    shared: Shared = Shared { cell: cellRef }
    input: Channel[Ref[String]] = Channel[Ref[String]]()
    started: Channel[Int] = Channel[Int]()
    ready: Channel[Int] = Channel[Int]()
    competitorInput: Channel[Ref[String]] = Channel[Ref[String]]()
    release: Channel[Int] = Channel[Int]()
    if true {
        text: String = " seven ".trim()
        borrowed: Ref[String] = text
        competitor: Future[Int] = spawn { compete(shared, competitorInput, release) }
        competitorInput.send(borrowed)
        pending: Future[Int] = spawn { install(shared, input, started, ready) }
        running: Int = started.recv()
        input.send(borrowed)
        installed: Int = ready.recv()
        finished: Int = joinAndClear(pending, shared)
        release.send(1)
        competing: Int = await competitor
    }
    snapshot: Cell = cell
    snapshot.entries["one"] to { value: Ref[String] -> print(value.len()), Null -> print(0) }
    return 0
}
