fn clearAndRead(out: Ref[Map[String, Ref[Int]]]!, readers: List[Ref[Map[String, Ref[Int]]]], index: Int): Map[String, Ref[Int]] {
    empty: Map[String, Ref[Int]] = {}
    out = empty
    readers[index] to {
        reader: Ref[Map[String, Ref[Int]]] -> {
            snapshot: Map[String, Ref[Int]] = reader
            return snapshot
        },
        Null -> { return empty }
    }
    return empty
}
fn produce(safe: Ref[Int], value: Int): Map[String, Ref[Int]] {
    borrowed: Ref[Int] = value
    first: Map[String, Ref[Int]]! = {"one": safe}
    target: Ref[Map[String, Ref[Int]]]! = first
    reader: Ref[Map[String, Ref[Int]]] = target
    second: Map[String, Ref[Int]] = {"one": borrowed}
    other: Ref[Map[String, Ref[Int]]] = second
    readers: List[Ref[Map[String, Ref[Int]]]] = [reader, other]
    return clearAndRead(target, readers, 1)
}
fn main(): Int {
    safe: Int = 9
    borrowed: Ref[Int] = safe
    entries: Map[String, Ref[Int]] = produce(borrowed, 7)
    print(entries.len())
    return 0
}
