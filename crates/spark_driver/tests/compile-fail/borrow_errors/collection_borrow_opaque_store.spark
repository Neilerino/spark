// TAG [SPARK-114]

link "union_probe"
extern fn opaque_map(value: Ref[Map[String, Ref[Int]]]!): Ref[Map[String, Ref[Int]]]!
fn fill(target: Ref[Map[String, Ref[Int]]]!): Void {
    pointer: Ref[Map[String, Ref[Int]]]! = opaque_map(target)
    local: Int = 7
    borrowed: Ref[Int] = local
    entries: Map[String, Ref[Int]] = {"one": borrowed}
    pointer = entries
}
fn main(): Int {
    entries: Map[String, Ref[Int]]! = {}
    target: Ref[Map[String, Ref[Int]]]! = entries
    fill(target)
    entries["one"] to { found: Ref[Int] -> print(found), Null -> print(0) }
    return 0
}
