// TAG [SPARK-114]

fn produce(): Channel[Ref[Int]] {
    local: Int = 7
    borrowed: Ref[Int] = local
    queue: Channel[Ref[Int]] = Channel[Ref[Int]]()
    queue.send(borrowed)
    return queue
}
fn main(): Int {
    queue: Channel[Ref[Int]] = produce()
    result: Ref[Int] = queue.recv()
    print(result)
    return 0
}
