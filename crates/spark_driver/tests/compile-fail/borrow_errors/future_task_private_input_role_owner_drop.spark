// TAG [SPARK-114]

async fn relay(input: Channel[Ref[String]], output: Channel[Ref[String]], ready: Channel[Int], started: Channel[Int]): Int {
    started.send(1)
    value: Ref[String] = input.recv()
    output.send(value)
    ready.send(1)
    return 0
}
fn launch(output: Channel[Ref[String]], ready: Channel[Int]): Tup[Channel[Ref[String]], Future[Int]!] {
    input: Channel[Ref[String]] = Channel[Ref[String]]()
    started: Channel[Int] = Channel[Int]()
    pending: Future[Int]! = spawn { relay(input, output, ready, started) }
    entered: Int = started.recv()
    return (input, pending)
}
fn main(): Int {
    output: Channel[Ref[String]] = Channel[Ref[String]]()
    ready: Channel[Int] = Channel[Int]()
    if true {
        launched: Tup[Channel[Ref[String]], Future[Int]!] = launch(output, ready)
        input: Channel[Ref[String]] = launched.0
        text: String = " seven ".trim()
        borrowed: Ref[String] = text
        input.send(borrowed)
        arrived: Int = ready.recv()
        joined: Future[Int] = launched.1
        completed: Int = await joined
    }
    result: Ref[String] = output.recv()
    print(result.len())
    return 0
}
