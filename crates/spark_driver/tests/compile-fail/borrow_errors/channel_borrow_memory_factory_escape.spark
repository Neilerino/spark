// TAG [SPARK-114]

fn empty(): Channel[Ref[Int]] { return Channel[Ref[Int]]() }
fn fill(target: Ref[Tup[Channel[Ref[Int]], Channel[Ref[Int]]]] !): Void {
    target = (empty(), empty())
}
fn produce(input: Ref[Int]): Ref[Int] {
    local: Int = 7
    localRef: Ref[Int] = local
    queues: Tup[Channel[Ref[Int]], Channel[Ref[Int]]]! = (empty(), empty())
    target: Ref[Tup[Channel[Ref[Int]], Channel[Ref[Int]]]] ! = queues
    fill(target)
    queues.0.send(input)
    queues.1.send(localRef)
    return queues.1.recv()
}
fn main(): Int {
    value: Int = 9
    input: Ref[Int] = value
    found: Ref[Int] = produce(input)
    print(found)
    return 0
}
