fn main(): Int {
    values: List[Int]! = [1, 2]
    borrowed: Ref[List[Int]] = values
    empty: Map[String, Ref[List[Int]]] = {}
    entries: Map[String, Ref[List[Int]]]! = {"one": borrowed}
    retained: Map[String, Ref[List[Int]]] = entries
    entries = empty
    values[0] = 9
    retained["one"] to { found: Ref[List[Int]] -> print(found.len()), Null -> print(99) }
    return 0
}
