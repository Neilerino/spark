// TAG [SPARK-114]

link "union_probe"
extern fn opaque_callback(target: Ref[(): Void]): Ref[(): Void]
fn repeat(): Void { repeat() }
fn invoke(callback: (): Void): Void {
    callback()
    repeat()
}
fn produce(value: Int): Map[String, Ref[Int]] {
    entries: Map[String, Ref[Int]]! = {}
    target: Ref[Map[String, Ref[Int]]]! = entries
    borrowed: Ref[Int] = value
    callback: (): Void = fn(): Void {
        next: Map[String, Ref[Int]] = {"one": borrowed}
        target = next
    }
    pointer: Ref[(): Void] = callback
    unproven: Ref[(): Void] = opaque_callback(pointer)
    unknown: (): Void = unproven
    invoke(unknown)
    return entries
}
fn main(): Int {
    value: Int = 7

    entries: Map[String, Ref[Int]] = produce(value)
    entries["one"] to { found: Ref[Int] -> print(found), Null -> print(0) }
    return 0
}
