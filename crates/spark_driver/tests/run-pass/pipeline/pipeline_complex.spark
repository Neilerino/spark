fn square(x: Int): Int {
    return x * x
}

fn addN(x: Int, n: Int): Int {
    return x + n
}

fn negate(x: Int): Int {
    return 0 - x
}

fn abs(x: Int): Int {
    if x < 0 {
        return 0 - x
    }
    return x
}

fn clamp_list(nums: List[Int], limit: Int): List[Int] {
    return nums map (n: Int): Int {
        if n > limit {
            limit
        } else {
            n
        }
    }
}

fn maybe_sqrt(x: Int): Int | String {
    if x < 0 {
        return "negative"
    }
    // Integer "square root" by linear scan — good enough for small values.
    i: Int! = 0
    loop {
        if i * i >= x {
            return i
        }
        i = i + 1
    }
    return 0
}

fn main(): Int {
    // ---------------------------------------------------------------
    // Stage 1: map → to sort → to reverse → to take
    //   [5, 2, 8, 1, 9, 3] → square → [25, 4, 64, 1, 81, 9]
    //   → sort → [1, 4, 9, 25, 64, 81]
    //   → reverse → [81, 64, 25, 9, 4, 1]
    //   → take 4 → [81, 64, 25, 9]
    // ---------------------------------------------------------------
    raw: List[Int] = [5, 2, 8, 1, 9, 3]
    top4_squares: List[Int] = raw map square
        to sort
        to reverse
        to take{count: 4}

    print(top4_squares.len())
    // → 4

    // ---------------------------------------------------------------
    // Stage 2: map with partial application chained with to
    //   [81, 64, 25, 9] → addN{n: 100} → [181, 164, 125, 109]
    //   → to clamp_list{limit: 150} → [150, 150, 125, 109]
    //   → reduce to sum → 150+150+125+109 = 534
    // ---------------------------------------------------------------
    shifted: List[Int] = top4_squares map addN{n: 100}
    clamped: List[Int] = shifted to clamp_list{limit: 150}
    sum: Int = clamped reduce 0 (acc: Int, n: Int): Int { acc + n }
    print(sum)
    // → 534

    // ---------------------------------------------------------------
    // Stage 3: map with lambda producing new list → to sort
    //   [150, 150, 125, 109] → negate → [-150, -150, -125, -109]
    //   → map abs → [150, 150, 125, 109]
    //   → to sort → [109, 125, 150, 150]
    // ---------------------------------------------------------------
    negated: List[Int] = clamped map negate
    restored: List[Int] = negated map abs to sort
    restored each (item: Int) { print(item) }
    // → 109, 125, 150, 150

    // ---------------------------------------------------------------
    // Stage 4: reduce — sum by fold
    //   [109, 125, 150, 150] → reduce 0 add → 534
    // ---------------------------------------------------------------
    total: Int = restored reduce 0 (acc: Int, n: Int): Int { acc + n }
    print(total)
    // → 534

    // ---------------------------------------------------------------
    // Stage 5: map fn ref + reduce combined
    //   [5, 2, 8, 1, 9, 3] → square → [25, 4, 64, 1, 81, 9]
    //   → reduce 0 add → 184
    // ---------------------------------------------------------------
    sum_of_squares: Int = raw map square reduce 0 (acc: Int, x: Int): Int { acc + x }
    print(sum_of_squares)
    // → 184

    // ---------------------------------------------------------------
    // Stage 6: to narrowing after fallible map
    //   Call maybe_sqrt on each value. It returns Int | String.
    //   Narrow with `to` to handle errors.
    // ---------------------------------------------------------------
    r1: Int | String = maybe_sqrt(16)
    v1: Int = r1 to { s: String -> -1 }
    print(v1)
    // → 4

    r2: Int | String = maybe_sqrt(-9)
    v2: Int = r2 to { s: String -> -1 }
    print(v2)
    // → -1

    // ---------------------------------------------------------------
    // Stage 7: to as pipeline function application chained
    //   5 → square → addN{n: 10} → 35
    // ---------------------------------------------------------------
    piped: Int = 5 to square to addN{n: 10}
    print(piped)
    // → 35

    // ---------------------------------------------------------------
    // Stage 8: closure captures inside map
    //   Capture a local in the lambda used by map.
    // ---------------------------------------------------------------
    offset: Int = 1000
    boosted: List[Int] = raw map (x: Int): Int { x + offset }
    // [1005, 1002, 1008, 1001, 1009, 1003] → sort → take 3
    top3_boosted: List[Int] = boosted to sort to take{count: 3}
    top3_boosted each (item: Int) { print(item) }
    // → 1001, 1002, 1003

    // ---------------------------------------------------------------
    // Stage 9: to reverse → map → reduce (full chain)
    //   [5, 2, 8, 1, 9, 3] → to reverse → [3, 9, 1, 8, 2, 5]
    //   → map square → [9, 81, 1, 64, 4, 25]
    //   → reduce 1 multiply → 9*81*1*64*4*25 = 4665600
    // ---------------------------------------------------------------
    big_product: Int = raw to reverse map square reduce 1 (acc: Int, x: Int): Int { acc * x }
    print(big_product)
    // → 4665600

    return 0
}
