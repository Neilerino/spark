// TAG [SPARK-114]

fn apply(callback: (): Ref[Int]): Ref[Int] { return callback() }
fn nest(callback: (): Ref[Int]): (): Ref[Int] { return fn(): Ref[Int] { return callback() } }
fn produce(input: Ref[Int]): Ref[Int] {
    local: Int = 7
    localRef: Ref[Int] = local
    privateQueue: Channel[Ref[Int]] = Channel[Ref[Int]]()
    privateQueue.send(localRef)
    requestedQueue: Channel[Ref[Int]] = Channel[Ref[Int]]()
    requestedQueue.send(input)
    read: (): Ref[Int] = fn(): Ref[Int] {
        privateValue: Ref[Int] = privateQueue.recv()
        print(privateValue)
        return requestedQueue.recv()
    }
    return apply(nest(nest(read)))
}
fn main(): Int {
    value: Int = 9
    input: Ref[Int] = value
    found: Ref[Int] = produce(input)
    print(found)
    return 0
}
