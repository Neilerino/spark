import spark.json { parse, JsonValue }

fn main(): Int {
    data: JsonValue = parse("[10, 20, 30]")
    if data.isError() {
        return 1
    }
    print(data.len())
    first: JsonValue = data.at(0)
    print(first.getNumber())
    last: JsonValue = data.at(2)
    print(last.getNumber())
    return 0
}
