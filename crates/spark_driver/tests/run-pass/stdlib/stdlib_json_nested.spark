import spark.json { parse, JsonValue }

fn main(): Int {
    data: JsonValue = parse("\{\"items\": [\{\"v\": \"first\"}, \{\"v\": \"second\"}]}")
    if data.isError() {
        return 1
    }
    items: JsonValue = data.get("items")
    print(items.len())
    a: JsonValue = items.at(0)
    av: JsonValue = a.get("v")
    print(av.getString())
    b: JsonValue = items.at(1)
    bv: JsonValue = b.get("v")
    print(bv.getString())
    return 0
}
