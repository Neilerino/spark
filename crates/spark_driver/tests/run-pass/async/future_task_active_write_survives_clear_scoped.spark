// TAG [SPARK-114]
struct Cell { entries: Map[String, Ref[String]]! }
struct Shared { cell: Ref[Cell]! }
async fn installAgain(shared: Shared, input: Channel[Ref[String]], started: Channel[Int], ready: Channel[Int], release: Channel[Int]): Int {
    started.send(1)
    value: Ref[String] = input.recv()
    entries: Map[String, Ref[String]] = {"one": value}
    cell: Ref[Cell]! = shared.cell
    cell.entries = entries
    ready.send(1)
    proceed: Int = release.recv()
    cell.entries = entries
    ready.send(1)
    return 0
}
fn main(): Int {
    empty: Map[String, Ref[String]] = {}
    cell: Cell! = Cell { entries: empty }
    cellRef: Ref[Cell]! = cell
    shared: Shared = Shared { cell: cellRef }
    input: Channel[Ref[String]] = Channel[Ref[String]]()
    started: Channel[Int] = Channel[Int]()
    ready: Channel[Int] = Channel[Int]()
    release: Channel[Int] = Channel[Int]()
    text: String = " seven ".trim()
    if true {
        borrowed: Ref[String] = text
        pending: Future[Int] = spawn { installAgain(shared, input, started, ready, release) }
        running: Int = started.recv()
        input.send(borrowed)
        first: Int = ready.recv()
        cleared: Map[String, Ref[String]] = {}
        cellRef.entries = cleared
        release.send(1)
        second: Int = ready.recv()
        finished: Int = await pending
    }
    snapshot: Cell = cell
    snapshot.entries["one"] to { value: Ref[String] -> print(value.len()), Null -> print(99) }
    return 0
}
