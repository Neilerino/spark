// TAG [SPARK-114]

async fn relay(input: Channel[Ref[String]], ready: Channel[Int]): Int {
    value: Ref[String] = input.recv()
    input.send(value)
    ready.send(1)
    return 0
}
fn main(): Int {
    input: Channel[Ref[String]] = Channel[Ref[String]]()
    ready: Channel[Int] = Channel[Int]()
    pending: Future[Int] = spawn { relay(input, ready) }
    text: String = " seven ".trim()
    borrowed: Ref[String] = text
    input.send(borrowed)
    arrived: Int = ready.recv()
    result: Ref[String] = input.recv()
    print(result.len())
    joined: Int = await pending
    return 0
}
