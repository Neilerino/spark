alias Value = Int | String

fn render(value: Value?): Int {
    if value is Null { return -1 }
    return value to {
        count: Int -> count,
        text: String -> text.len()
    }
}

fn main(): Int {
    print(render(7))
    suffix: String = "owned"
    print(render("text-{suffix}"))
    print(render(Null))
    pretyped: Value = "value-{suffix}"
    print(render(pretyped))
    print(render(pretyped))
    return 0
}
