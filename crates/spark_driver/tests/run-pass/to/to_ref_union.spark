struct MyError {
    code: Int
    message: String
}

struct Data {
    value: Int
}

fn handler(r: Ref[Data]): Ref[Data] | MyError {
    return r
}

fn main(): Int {
    d: Ref[Data] = Data { value: 42 }

    handler(d) to {
        e: MyError -> {
            print("error")
        }
        r: Ref[Data] -> {
            print("ok")
        }
    }

    return 0
}
