fn add_ten(nums: List[Int]): List[Int] {
    result: List[Int] = nums map (n: Int): Int {
        n + 10
    }
    return result
}

fn main(): Int {
    nums: List[Int] = [1, 2, 3]
    transformed: List[Int] = nums to add_ten
    transformed each (item: Int) {
        print(item)
    }
    return 0
}
