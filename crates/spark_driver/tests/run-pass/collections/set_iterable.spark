fn show(value: String): Void {
    print(value)
}

fn main(): Int {
    tags: Set[String]! = {}
    tags each show
    empty: List[String] = tags filter (value: String): Bool { value.len() > 3 }
    print(empty.len())
    tags.add("red")
    tags.add("blue")
    tags.add("green")
    tags.add("red")
    tags.remove("green")
    tags each show
    selected: List[String] = tags filter (value: String): Bool { value.len() > 3 }
    selected each show
    numbers: Set[Int] = {1, 2, 3, 2}
    total: Int = numbers filter (value: Int): Bool { value > 1 }
        reduce 0 (sum: Int, value: Int): Int { sum + value }
    print(total)
    grown: Set[Int]! = {}
    n: Int! = 0
    loop {
        if n == 20 { break }
        grown.add(n)
        n += 1
    }
    grown.remove(3)
    grown.remove(16)
    remaining: List[Int] = grown filter (value: Int): Bool { value >= 0 }
    print(remaining.len())
    sum: Int = remaining reduce 0 (acc: Int, value: Int): Int { acc + value }
    print(sum)
    return 0
}
