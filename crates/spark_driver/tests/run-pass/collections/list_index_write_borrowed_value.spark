alias RefOrString = Ref[Int] | String

fn main(): Int {
    number: Int = 8
    borrowed: Ref[Int] = number
    text: RefOrString = "old"
    values: List[RefOrString]! = [text]
    values[0] = borrowed
    value: RefOrString = values[0] ?? text
    value to {
        found: Ref[Int] -> print(found),
        String -> print(98)
    }
    return 0
}
