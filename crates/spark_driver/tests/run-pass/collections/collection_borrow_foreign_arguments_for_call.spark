// TAG [SPARK-114]

link "union_probe"
extern fn inspect(target: Ref[Map[String, Ref[Int]]]!, borrowed: Ref[Int]): Void
fn main(): Int {
    value: Int = 7
    borrowed: Ref[Int] = value
    entries: Map[String, Ref[Int]]! = {"one": borrowed}
    target: Ref[Map[String, Ref[Int]]]! = entries
    inspect(target, borrowed)
    entries["one"] to { found: Ref[Int] -> print(found), Null -> print(0) }
    return 0
}
