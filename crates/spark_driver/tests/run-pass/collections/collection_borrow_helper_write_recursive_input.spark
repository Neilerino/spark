fn store(out: Ref[Map[String, Ref[Int]]]!, value: Ref[Int]): Void {
    entries: Map[String, Ref[Int]] = {"one": value}
    out = entries
}
fn fill(out: Ref[Map[String, Ref[Int]]]!, value: Ref[Int], depth: Int): Void {
    if depth > 0 {
        fill(out, value, depth - 1)
    } else {
        store(out, value)
    }
}
fn produce(value: Ref[Int]): Map[String, Ref[Int]] {
    entries: Map[String, Ref[Int]]! = {}
    fill(entries, value, 2)
    return entries
}
fn main(): Int {
    value: Int = 7
    borrowed: Ref[Int] = value
    entries: Map[String, Ref[Int]] = produce(borrowed)
    entries["one"] to { found: Ref[Int] -> print(found), Null -> print(99) }
    return 0
}
