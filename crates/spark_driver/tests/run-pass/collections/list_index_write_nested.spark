fn rhs(): Int {
    print("value")
    return 9
}

fn index(label: String, at: Int): Int {
    print(label)
    return at
}

fn main(): Int {
    row: List[Int] = [4, 5]
    items: List[List[Int]]! = [row, [6]]
    original: List[List[Int]] = items
    items[index("outer", 0)][index("inner", 1)] = rhs()
    items[1][0] = 8
    print((items[0] ?? [0, 0])[0] ?? -1)
    print((items[0] ?? [0, 0])[1] ?? -1)
    print((items[1] ?? [0])[0] ?? -1)
    print((original[0] ?? [0, 0])[1] ?? -1)
    print((original[1] ?? [0])[0] ?? -1)
    print(row[1] ?? -1)
    return 0
}
