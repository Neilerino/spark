fn point(x: Int, y: Int): Tup[Int, Int] {
    return (x, y)
}

fn exitsEarly(items: List[Int]): Bool {
    return items.contains({ return true })
}

fn main(): Int {
    first: Tup[Int, Int] = point(1, 2)
    same: Tup[Int, Int] = point(1, 2)
    different: Tup[Int, Int] = point(1, 3)
    pairs: List[Tup[Int, Int]] = [first]
    print(first == same)
    print(pairs.contains(same))
    print(pairs.contains(point(1, 2)))
    print(pairs.contains(different))
    print(exitsEarly([1]))
    return 0
}
