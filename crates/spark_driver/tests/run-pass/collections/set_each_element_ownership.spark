link "union_probe"

extern fn probe_string_rc(value: Ref[String]): Int
extern fn probe_set_rc(value: Ref[Set[String]]): Int

fn receiver(values: Set[String]): Set[String] {
    print("receiver")
    return values
}

fn make_visitor(capture: String): (String): Void {
    print("visitor")
    return fn(element: String): Void {
        print(element.len())
        print(capture.len())
    }
}

fn main(): Int {
    suffix: String = "ey"
    key: String = "k{suffix}"
    values: Set[String]! = {}
    receiver(values).eachElement(make_visitor(key))
    values.add(key)
    keyBefore: Int = probe_string_rc(key)
    setBefore: Int = probe_set_rc(values)
    receiver(values).eachElement(make_visitor(key))
    print(probe_string_rc(key) - keyBefore)
    print(probe_set_rc(values) - setBefore)
    return 0
}
