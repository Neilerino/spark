fn point(x: Int, y: Int): Tup[Int, Int] {
    return (x, y)
}

fn main(): Int {
    first: Tup[Int, Int] = point(1, 2)
    same: Tup[Int, Int] = point(1, 2)
    differentX: Tup[Int, Int] = point(2, 2)
    differentY: Tup[Int, Int] = point(1, 3)
    print(first == same)
    print(first != same)
    print(first == differentX)
    print(first != differentY)
    print(point(3, 4) == point(3, 4))
    current: Tup[Int, Int]! = point(1, 2)
    print(current == {
        current = point(4, 5)
        point(1, 2)
    })
    print(current == point(4, 5))
    aliasSource: Tup[Int, Int]! = point(1, 2)
    print(aliasSource == {
        target: Ref[Tup[Int, Int]]! = aliasSource
        target = point(4, 2)
        point(1, 2)
    })
    print(aliasSource.0)
    return 0
}
