fn update(names: Set[String]!, key: String!): Bool {
    names.add(key)
    print(names.contains(key))
    names.remove(key)
    return names.contains(key)
}

fn main(): Int {
    key: String! = "a"
    counts: Map[String, Int]! = {"a": 1}
    print(counts.contains(key))
    counts.remove(key)
    print(counts.contains(key))

    return 0
}
