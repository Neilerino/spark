fn main(): Int {
    items: List[Int]! = [4, 5, 6]
    original: List[Int] = items
    items[1] = 9
    print(items.len())
    print(items[0] ?? -1)
    print(items[1] ?? -1)
    print(items[2] ?? -1)
    print(original.len())
    print(original[0] ?? -1)
    print(original[1] ?? -1)
    print(original[2] ?? -1)
    return 0
}
