fn main(): Int {
    values: List[Int]! = [1, 2]
    empty: Map[String, Ref[List[Int]]] = {}
    retained: Map[String, Ref[List[Int]]]! = empty
    count: Int! = 0
    loop {
        retained = empty
        values[0] = count
        borrowed: Ref[List[Int]] = values
        retained = {"one": borrowed}
        retained["one"] to { fresh: Ref[List[Int]] -> print(fresh.len()), Null -> print(0) }
        count = count + 1
        if count == 2 { break }
    }
    return 0
}
