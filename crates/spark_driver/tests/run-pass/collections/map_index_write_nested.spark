fn value(): Int {
    print("value")
    return 9
}

fn row(): Int {
    print("row")
    return 0
}

fn key(): String {
    print("key")
    return "a"
}

fn main(): Int {
    seed: Map[String, Int] = {"a": 1}
    rows: List[Map[String, Int]]! = [seed]
    original: List[Map[String, Int]] = rows
    rows[row()][key()] = value()
    rows[0]["b"] = 7
    print((rows[0] ?? seed)["a"] ?? -1)
    print((rows[0] ?? seed)["b"] ?? -1)
    print((original[0] ?? seed)["a"] ?? -1)
    print((original[0] ?? seed)["b"] ?? -1)
    print(seed["a"] ?? -1)
    print(seed["b"] ?? -1)
    return 0
}
