fn clear(out: Ref[Map[String, Ref[Int]]]!): Void {
    empty: Map[String, Ref[Int]] = {}
    out = empty
}
fn produce(): Map[String, Ref[Int]] {
    value: Int = 7
    borrowed: Ref[Int] = value
    entries: Map[String, Ref[Int]]! = {"one": borrowed}
    clear(entries)
    return entries
}
fn main(): Int { entries: Map[String, Ref[Int]] = produce()
    print(entries.len())
    return 0 }
