alias MaybeInt = Int?
alias IntOrString = Int | String

fn main(): Int {
    none: MaybeInt = Null
    options: List[MaybeInt]! = [none]
    options[0] = 9
    options[0] to {
        value: MaybeInt -> print(value ?? -1),
        Null -> print("missing")
    }
    options[0] = Null
    options[0] to {
        value: MaybeInt -> print(value ?? -1),
        Null -> print("missing")
    }

    first: IntOrString = 4
    values: List[IntOrString]! = [first]
    values[0] = "changed"
    values[0] to {
        value: IntOrString -> value to {
            n: Int -> print(n),
            s: String -> print(s)
        },
        Null -> print("missing")
    }
    return 0
}
