fn show(key: String, count: Int): Void {
    print(key)
    print(count)
}

fn main(): Int {
    words: List[String] = ["red", "blue", "red"]
    counts: Map[String, Int]! = {}
    i: Int! = 0
    loop {
        if i == words.len() { break }
        word: String = words[i] ?? ""
        counts[word] = (counts[word] ?? 0) + 1
        i += 1
    }
    counts.eachEntry(show)
    return 0
}
