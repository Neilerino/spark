import spark.json { parse, JsonValue }

fn main(): Int {
    data: JsonValue = parse("\{\"name\": \"Alice\", \"age\": 30}")
    if data.isError() {
        return 1
    }
    name: JsonValue = data.get("name")
    print(name.getString())
    age: JsonValue = data.get("age")
    print(age.getNumber())
    return 0
}
