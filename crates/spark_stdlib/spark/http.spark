module http

// =============================================================================
// Types
// =============================================================================

/// An HTTP response from a client request.
pub struct Response {
    status: Int,
    body: String,
    headers: String
}

/// An opaque handle to an incoming HTTP request (server-side).
pub struct Request {
    handle: Int
}

/// An opaque handle to an HTTP server.
pub struct Server {
    handle: Int
}

/// An error from an HTTP operation. Code 0 means no error.
pub struct HttpError {
    code: Int
}

// =============================================================================
// Extern FFI declarations (private)
// =============================================================================

extern fn __spark_http_get(url: String, headers: String): Int
extern fn __spark_http_post(url: String, body: String, headers: String): Int
extern fn __spark_http_put(url: String, body: String, headers: String): Int
extern fn __spark_http_delete(url: String, headers: String): Int
extern fn __spark_http_response_body(): String
extern fn __spark_http_response_headers(): String
extern fn __spark_http_error(): String

extern fn __spark_http_serve(addr: String, port: Int): Int
extern fn __spark_http_server_addr(server_handle: Int): String
extern fn __spark_http_recv(server_handle: Int): Int
extern fn __spark_http_request_method(req_handle: Int): String
extern fn __spark_http_request_url(req_handle: Int): String
extern fn __spark_http_request_body(req_handle: Int): String
extern fn __spark_http_request_header(req_handle: Int, name: String): String
extern fn __spark_http_respond(req_handle: Int, status: Int, body: String, headers: String): Int
extern fn __spark_http_close_server(server_handle: Int): Void
extern fn __spark_http_close_request(req_handle: Int): Void

// =============================================================================
// Module-level functions
// =============================================================================

/// Returns the last HTTP error message.
pub fn lastError(): String {
    return __spark_http_error()
}

/// Performs an HTTP GET request.
/// Returns a Response with status -1 on error; check lastError().
pub fn get(url: String): Response {
    status: Int = __spark_http_get(url, "")
    return Response {
        status: status,
        body: __spark_http_response_body(),
        headers: __spark_http_response_headers()
    }
}

/// Performs an HTTP GET request with custom headers.
/// Headers are newline-separated "Key: Value" pairs.
pub fn getWithHeaders(url: String, headers: String): Response {
    status: Int = __spark_http_get(url, headers)
    return Response {
        status: status,
        body: __spark_http_response_body(),
        headers: __spark_http_response_headers()
    }
}

/// Performs an HTTP POST request.
pub fn post(url: String, body: String): Response {
    status: Int = __spark_http_post(url, body, "")
    return Response {
        status: status,
        body: __spark_http_response_body(),
        headers: __spark_http_response_headers()
    }
}

/// Performs an HTTP POST request with custom headers.
pub fn postWithHeaders(url: String, body: String, headers: String): Response {
    status: Int = __spark_http_post(url, body, headers)
    return Response {
        status: status,
        body: __spark_http_response_body(),
        headers: __spark_http_response_headers()
    }
}

/// Performs an HTTP PUT request.
pub fn put(url: String, body: String): Response {
    status: Int = __spark_http_put(url, body, "")
    return Response {
        status: status,
        body: __spark_http_response_body(),
        headers: __spark_http_response_headers()
    }
}

/// Performs an HTTP PUT request with custom headers.
pub fn putWithHeaders(url: String, body: String, headers: String): Response {
    status: Int = __spark_http_put(url, body, headers)
    return Response {
        status: status,
        body: __spark_http_response_body(),
        headers: __spark_http_response_headers()
    }
}

/// Performs an HTTP DELETE request.
pub fn delete(url: String): Response {
    status: Int = __spark_http_delete(url, "")
    return Response {
        status: status,
        body: __spark_http_response_body(),
        headers: __spark_http_response_headers()
    }
}

/// Performs an HTTP DELETE request with custom headers.
pub fn deleteWithHeaders(url: String, headers: String): Response {
    status: Int = __spark_http_delete(url, headers)
    return Response {
        status: status,
        body: __spark_http_response_body(),
        headers: __spark_http_response_headers()
    }
}

/// Creates an HTTP server listening on the given address and port.
/// Returns a Server with handle -1 on error; check lastError().
pub fn serve(addr: String, port: Int): Server {
    return Server { handle: __spark_http_serve(addr, port) }
}

// =============================================================================
// Interface bindings — method-style API
// =============================================================================

/// Methods available on an HTTP server.
pub interface IServer {
    fn recv(): Request
    fn addr(): String
    fn close(): Void
}

Server binds IServer {
    fn recv(server: Server): Request {
        return Request { handle: __spark_http_recv(server.handle) }
    }
    fn addr(server: Server): String {
        return __spark_http_server_addr(server.handle)
    }
    fn close(server: Server): Void {
        __spark_http_close_server(server.handle)
    }
}

/// Methods available on an HTTP request.
pub interface IRequest {
    fn method(): String
    fn url(): String
    fn body(): String
    fn header(name: String): String
    fn respond(status: Int, body: String, headers: String): HttpError
    fn close(): Void
}

Request binds IRequest {
    fn method(req: Request): String {
        return __spark_http_request_method(req.handle)
    }
    fn url(req: Request): String {
        return __spark_http_request_url(req.handle)
    }
    fn body(req: Request): String {
        return __spark_http_request_body(req.handle)
    }
    fn header(req: Request, name: String): String {
        return __spark_http_request_header(req.handle, name)
    }
    fn respond(req: Request, status: Int, body: String, headers: String): HttpError {
        return HttpError { code: __spark_http_respond(req.handle, status, body, headers) }
    }
    fn close(req: Request): Void {
        __spark_http_close_request(req.handle)
    }
}

/// Error checking method for HTTP errors.
pub interface IHttpError {
    fn failed(): Bool
}

HttpError binds IHttpError {
    fn failed(err: HttpError): Bool {
        return err.code != 0
    }
}
