// Pattern matching examples

fn describe_number(n: Int): String {
    match n {
        0 -> "zero",
        1 -> "one",
        2 -> "two",
        _ -> "many",
    }
}

fn classify(value: Int): String {
    match value {
        n if n < 0 -> "negative",
        0 -> "zero",
        n if n > 100 -> "large",
        _ -> "positive",
    }
}

fn process_option[T](opt: Option[T]): String {
    match opt {
        Option.Some(x) -> "has value",
        Option.None -> "empty",
    }
}

fn handle_result[T, E](result: Result[T, E]): T | E {
    match result {
        Result.Ok(value) -> value,
        Result.Err(error) -> error,
    }
}

fn destructure_point(point: Point): Float {
    match point {
        Point { x, y } -> x + y,
    }
}

fn match_tuple(pair: Tup[Int, String]): String {
    match pair {
        (0, s) -> "zero: " + s,
        (n, s) -> n.toString() + ": " + s,
    }
}

fn match_list(items: List[Int]): String {
    match items {
        [] -> "empty",
        [x] -> "single: " + x.toString(),
        [first, second] -> "pair",
        [first, ...rest] -> "multiple: " + first.toString(),
    }
}

fn or_pattern(value: Int): Bool {
    match value {
        1 | 2 | 3 -> true,
        _ -> false,
    }
}

fn type_narrowing(value: Int | String): String {
    match value {
        n: Int -> "number: " + n.toString(),
        s: String -> "string: " + s,
    }
}
