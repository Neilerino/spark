// Test: spark bindgen sqlite3 integration
//
// Uses bindgen-generated bindings to call a C helper wrapping sqlite3.
// Verifies: open, roundtrip (CREATE+INSERT+SELECT), close, version query.

link "sqlite_helper" from "."
link "sqlite3"

// Generated by spark bindgen from sqlite_helper.h
extern fn spark_sqlite_open_memory(): Int
extern fn spark_sqlite_roundtrip(): Int
extern fn spark_sqlite_close(): Int
extern fn spark_sqlite_version_number(): Int

fn main(): Int {
    // 1. Check sqlite version (confirms linking works).
    version: Int = spark_sqlite_version_number()
    print("sqlite3 version:")
    print(version)

    // 2. Open in-memory database.
    rc: Int = spark_sqlite_open_memory()
    if rc != 0 {
        print("FAIL: open returned non-zero")
        return 1
    }
    print("open: ok")

    // 3. Round-trip: CREATE TABLE, INSERT 42, SELECT → should return 42.
    value: Int = spark_sqlite_roundtrip()
    print("roundtrip value:")
    print(value)
    if value != 42 {
        print("FAIL: expected 42")
        return 1
    }
    print("roundtrip: ok")

    // 4. Close.
    rc2: Int = spark_sqlite_close()
    if rc2 != 0 {
        print("FAIL: close returned non-zero")
        return 1
    }
    print("close: ok")

    print("ALL TESTS PASSED")
    return 0
}
