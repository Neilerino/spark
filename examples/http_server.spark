import spark.http { serve, Server, Request }

fn main(): Int {
    server: Server = serve("127.0.0.1", 8080)
    print("Listening on http://127.0.0.1:8080")
    print("Hit it with: curl http://127.0.0.1:8080/anything")
    print("Press Ctrl-C to stop")

    count: Int! = 0
    loop {
        req: Request = server.recv()
        m: String = req.method()
        p: String = req.url()
        count = count + 1

        print(m)
        print(p)
        print(count)

        req.respond(200, "Hello from Spark!\n", "Content-Type: text/plain\nX-Request-Number: 1")
    }

    server.close()
    return 0
}
