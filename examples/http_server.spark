import spark.http { serve, serverAddr, recv, respond, method, url,
                     closeServer, Server, Request, HttpError }

fn main(): Int {
    server: Server = serve("127.0.0.1", 8080)
    print("Listening on http://127.0.0.1:8080")
    print("Hit it with: curl http://127.0.0.1:8080/anything")
    print("Press Ctrl-C to stop")

    count: Int! = 0
    loop {
        req: Request = recv(server)
        m: String = method(req)
        p: String = url(req)
        count = count + 1

        print(m)
        print(p)
        print(count)

        respond(req, 200, "Hello from Spark!\n", "Content-Type: text/plain\nX-Request-Number: 1")
    }

    closeServer(server)
    return 0
}
