{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Spark",
  "scopeName": "source.spark",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#function-definition" },
    { "include": "#function-call" },
    { "include": "#parameter-list" },
    { "include": "#mutability-marker" },
    { "include": "#builtin-types" },
    { "include": "#property-access" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.spark",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.spark",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.spark",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.spark",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.spark",
          "match": "'(\\\\.|[^'])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.spark",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.spark",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.float.spark",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\\b"
        },
        {
          "name": "constant.numeric.integer.spark",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.spark",
          "match": "\\b(true|false|Null)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.spark",
          "match": "\\b(if|else|match|loop|break|continue|return|each|via|to)\\b"
        },
        {
          "name": "keyword.declaration.spark",
          "match": "\\b(fn|struct|enum|interface|type|alias|const|pub|module|binding)\\b"
        },
        {
          "name": "keyword.other.spark",
          "match": "\\b(using|import|and|or|not|is|as|binds|extends|async|await|spawn|block)\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "comment": "Function definition: fn name(...)",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.spark" },
            "2": { "name": "entity.name.function.spark" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "comment": "Function/method call: name(...) — but not keywords or types",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.spark" }
          }
        }
      ]
    },
    "parameter-list": {
      "patterns": [
        {
          "comment": "Parameter in fn signature or lambda: name: Type",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=:\\s*[A-Z])",
          "captures": {
            "1": { "name": "variable.parameter.spark" }
          }
        }
      ]
    },
    "mutability-marker": {
      "patterns": [
        {
          "comment": "Mutable type suffix: Int!, List[Int]!",
          "match": "(?<=[A-Za-z0-9\\]])!",
          "name": "storage.modifier.mutable.spark"
        }
      ]
    },
    "builtin-types": {
      "patterns": [
        {
          "comment": "Built-in primitive and collection types",
          "name": "support.type.spark",
          "match": "\\b(Int|Int8|Int16|Int32|Int64|UInt|UInt8|UInt16|UInt32|UInt64|Float|Float32|Float64|Bool|Char|String|Byte|Void|Never|List|Map|Set|Tup|Ref|Weak|Channel|Mutex|Handle|ThreadPool)\\b"
        }
      ]
    },
    "property-access": {
      "patterns": [
        {
          "comment": "Property/field access: .name",
          "match": "\\.\\s*([a-z_][a-zA-Z0-9_]*)\\s*(?!\\()",
          "captures": {
            "1": { "name": "variable.other.property.spark" }
          }
        },
        {
          "comment": "Method call on receiver: .name(",
          "match": "\\.\\s*([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.spark" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "User-defined types (PascalCase not matched by builtin-types)",
          "name": "entity.name.type.spark",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.spark",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.comparison.spark",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.spark",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.spark",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.other.spark",
          "match": "\\.\\.|\\.\\.|[&|^~]"
        }
      ]
    }
  }
}
