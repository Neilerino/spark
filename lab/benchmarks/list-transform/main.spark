fn main(): Int {
    nums: List[Int] = [1..=1000000]

    squared: List[Int] = nums each via (x: Int): Int { x * x }
    modded: List[Int] = squared each via (x: Int): Int { x % 1000 }

    total: Int! = 0
    j: Int! = 0
    loop {
        if j >= modded.len() {
            break
        }
        total = total + modded[j]
        j = j + 1
    }

    print(total)
    return 0
}
